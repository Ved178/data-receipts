[Unit]
Description=DigIn DNS logger + Shield (Data Receipt)
After=network-online.target NetworkManager.service
Wants=network-online.target
# At boot it starts before ap0 has 10.42.0.1 and fails to bind; keep retrying every second
# (no start limit) until digin-box.service brings the hotspot up.
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=DIGIN_DB=/home/arduino/digin/digin.db PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /home/arduino/madhacks26/dns/digin_dns.py serve --listen 10.42.0.1
UMask=0000
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
