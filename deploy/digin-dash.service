[Unit]
Description=Data Receipt dashboard (http://10.42.0.1, DigIn only; not reachable from the venue network)
After=digin-dns.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=DIGIN_DB=/home/arduino/digin/digin.db PYTHONDONTWRITEBYTECODE=1
UMask=0000
ExecStart=/usr/bin/python3 /home/arduino/madhacks26/dashboard/app.py --host 10.42.0.1 --port 80
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
